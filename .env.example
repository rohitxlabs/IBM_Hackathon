# --- Database (PostgreSQL / Neon) ---
# Pooled connection used by the application at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Random 32+ byte secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# --- AI (server-only, never exposed to the browser) ---
# Valid values: gemini | mock
AI_PROVIDER="mock"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"