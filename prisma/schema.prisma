// Jinni — AI learning platform
// Prisma schema: 16 core models. Progress is derived from academic data,
// so there is deliberately no progress table.

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  PARENT
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum ExamType {
  QUIZ
  UNIT_TEST
  MIDTERM
  FINAL
  PRACTICAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum PracticeTestStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

/// What a quiz is for. All three share one generation and grading pipeline.
enum QuizKind {
  /// Built by a teacher from a learning session and assigned to a class.
  TEACHER_ASSIGNED
  /// Generated by Jinni to target a student's weak concepts.
  PERSONALIZED
  /// Student-initiated practice.
  SELF_PRACTICE
}

/// Teacher-authored quizzes are not visible to students until approved.
enum QuizReviewStatus {
  PENDING_REVIEW
  APPROVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

/// Banding applied to a concept's accuracy within an attempt.
enum ConceptLevel {
  WEAK
  AVERAGE
  STRONG
}

enum MistakeSource {
  ASSIGNMENT
  EXAM
  PRACTICE
  SELF_REPORTED
}

/// 1. users — authentication + identity for every role
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
  teacher Teacher?
  parent  Parent?

  gradedSubmissions Submission[]     @relation("SubmissionGrader")
  recordedResults   ExamResult[]     @relation("ExamResultRecorder")
  sentMessages      Message[]        @relation("MessageSender")
  receivedMessages  Message[]        @relation("MessageRecipient")
  notifications     Notification[]
  authoredQuizzes   PracticeTest[]   @relation("QuizAuthor")
  quizAssignments   QuizAssignment[] @relation("QuizAssigner")
  conversationsA    Conversation[]   @relation("ConversationParticipantA")
  conversationsB    Conversation[]   @relation("ConversationParticipantB")

  @@index([role])
  @@map("users")
}

/// 2. students
model Student {
  id          String    @id @default(cuid())
  userId      String    @unique
  rollNumber  String    @unique
  gradeLevel  Int
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents             StudentParent[]
  classes             ClassStudent[]
  submissions         Submission[]
  examResults         ExamResult[]
  mistakes            Mistake[]
  practiceTests       PracticeTest[]
  messages            Message[]
  quizAssignments     QuizAssignment[]
  quizAttempts        QuizAttempt[]
  conceptPerformances ConceptPerformance[]
  aiAnalyses          AIAnalysis[]
  conversations       Conversation[]

  @@index([gradeLevel])
  @@map("students")
}

/// 3. teachers
model Teacher {
  id         String   @id @default(cuid())
  userId     String   @unique
  employeeId String   @unique
  department String?
  bio        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes          Class[]
  subjects         Subject[]
  assignments      Assignment[]
  exams            Exam[]
  learningSessions LearningSession[]

  @@map("teachers")
}

/// 4. parents
model Parent {
  id         String   @id @default(cuid())
  userId     String   @unique
  phone      String?
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children StudentParent[]

  @@map("parents")
}

/// 5. student_parents — many-to-many link between students and guardians
model StudentParent {
  id           String   @id @default(cuid())
  studentId    String
  parentId     String
  relationship String   @default("GUARDIAN")
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
}

/// 6. classes
model Class {
  id           String   @id @default(cuid())
  name         String
  section      String
  academicYear String
  gradeLevel   Int
  teacherId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher          Teacher           @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  students         ClassStudent[]
  subjects         Subject[]
  assignments      Assignment[]
  exams            Exam[]
  learningSessions LearningSession[]
  quizAssignments  QuizAssignment[]

  @@unique([name, section, academicYear])
  @@index([teacherId])
  @@map("classes")
}

/// 7. class_students — enrollment
model ClassStudent {
  id         String   @id @default(cuid())
  classId    String
  studentId  String
  enrolledAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("class_students")
}

/// 8. subjects
model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  classId     String?
  teacherId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class            Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacher          Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  topics           Topic[]
  assignments      Assignment[]
  exams            Exam[]
  mistakes         Mistake[]
  practiceTests    PracticeTest[]
  learningSessions LearningSession[]

  @@index([classId])
  @@index([teacherId])
  @@map("subjects")
}

/// 9. topics
model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignments         Assignment[]
  exams               Exam[]
  mistakes            Mistake[]
  practiceTests       PracticeTest[]
  practiceQuestions   PracticeQuestion[]
  learningSessions    LearningSession[]
  conceptPerformances ConceptPerformance[]

  @@unique([subjectId, name])
  @@index([subjectId])
  @@map("topics")
}

/// 10. assignments
model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  classId     String
  subjectId   String
  topicId     String?
  teacherId   String
  dueDate     DateTime
  maxScore    Int      @default(100)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([dueDate])
  @@map("assignments")
}

/// 11. submissions
model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  fileUrl      String?
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now())
  score        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedById   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("submissions")
}

/// 12. exams
model Exam {
  id              String   @id @default(cuid())
  title           String
  description     String?
  classId         String
  subjectId       String
  topicId         String?
  teacherId       String
  examType        ExamType @default(UNIT_TEST)
  examDate        DateTime
  durationMinutes Int      @default(60)
  maxScore        Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic   Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  teacher Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  results ExamResult[]

  @@index([classId])
  @@index([subjectId])
  @@index([examDate])
  @@map("exams")
}

/// 13. exam_results
model ExamResult {
  id           String   @id @default(cuid())
  examId       String
  studentId    String
  score        Int
  grade        String?
  remarks      String?
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exam       Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("ExamResultRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("exam_results")
}

/// 14. mistakes — feeds weak-topic detection
model Mistake {
  id            String        @id @default(cuid())
  studentId     String
  subjectId     String
  topicId       String?
  question      String
  studentAnswer String
  correctAnswer String
  explanation   String?
  source        MistakeSource @default(SELF_REPORTED)
  sourceId      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([studentId, subjectId])
  @@index([topicId])
  @@index([createdAt])
  @@map("mistakes")
}

/// 15. practice_tests
/// A quiz. `kind` distinguishes teacher-assigned work, Jinni's personalised
/// follow-ups and self-serve practice; they share questions, attempts and
/// grading so the adaptive loop has one pipeline rather than three.
model PracticeTest {
  id                String             @id @default(cuid())
  /// The student a personalised or self-practice quiz belongs to. Null for a
  /// teacher-assigned quiz, which is owned by its class instead.
  studentId         String?
  subjectId         String
  topicId           String?
  title             String
  difficulty        Difficulty         @default(MEDIUM)
  questionType      QuestionType       @default(MCQ)
  questionCount     Int                @default(5)
  status            PracticeTestStatus @default(DRAFT)
  score             Int?
  totalScore        Int?
  startedAt         DateTime?
  completedAt       DateTime?
  generatedBy       String             @default("mock")
  kind              QuizKind           @default(SELF_PRACTICE)
  reviewStatus      QuizReviewStatus   @default(APPROVED)
  /// Teacher material this quiz was generated from.
  learningSessionId String?
  createdByUserId   String?
  /// Set on a personalised quiz: the attempt whose weak concepts it targets.
  sourceAttemptId   String?
  /// Concept tags the quiz deliberately focuses on.
  targetConcepts    Json?
  instructions      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  student         Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic           Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  learningSession LearningSession?   @relation(fields: [learningSessionId], references: [id], onDelete: SetNull)
  createdBy       User?              @relation("QuizAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  questions       PracticeQuestion[]
  assignments     QuizAssignment[]
  attempts        QuizAttempt[]

  @@index([studentId, status])
  @@index([subjectId])
  @@index([kind, reviewStatus])
  @@index([learningSessionId])
  @@map("practice_tests")
}

/// 16. practice_questions
model PracticeQuestion {
  id             String       @id @default(cuid())
  practiceTestId String
  topicId        String?
  orderIndex     Int          @default(0)
  questionType   QuestionType @default(MCQ)
  prompt         String
  options        Json?
  correctAnswer  String
  /// The concept this question tests, e.g. "Completing the Square". This is
  /// what lets Jinni say which ideas a student has and has not grasped,
  /// rather than reporting a single overall score.
  conceptTag     String?
  difficulty     Difficulty   @default(MEDIUM)
  /// Latest answer, denormalised from StudentAnswer so existing single-attempt
  /// reads keep working. StudentAnswer rows remain the source of truth.
  studentAnswer  String?
  isCorrect      Boolean?
  explanation    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  practiceTest PracticeTest    @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  topic        Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  answers      StudentAnswer[]

  @@unique([practiceTestId, orderIndex])
  @@index([practiceTestId])
  @@index([conceptTag])
  @@map("practice_questions")
}

/// Parent ↔ teacher messaging about a specific student.
model Message {
  id              String    @id @default(cuid())
  senderUserId    String
  recipientUserId String
  studentId       String
  conversationId  String?
  body            String
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sender       User          @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient    User          @relation("MessageRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([recipientUserId, readAt])
  @@index([senderUserId])
  @@index([studentId, createdAt])
  @@map("messages")
}

enum NotificationType {
  ASSIGNMENT
  GRADE
  EXAM
  MESSAGE
}

/// Lightweight in-app notifications. Deliberately simple: one row per event.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// What a teacher taught, plus the material Jinni generates questions from.
/// One session can produce several quizzes as the class progresses.
model LearningSession {
  id         String   @id @default(cuid())
  teacherId  String
  classId    String?
  subjectId  String
  topicId    String?
  title      String
  /// Lesson notes or learning material the questions are grounded in.
  material   String
  gradeLevel Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic   Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  quizzes PracticeTest[]

  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@map("learning_sessions")
}

/// Who a quiz has been given to. A quiz may go to a whole class, to named
/// students, or both.
model QuizAssignment {
  id           String    @id @default(cuid())
  quizId       String
  classId      String?
  studentId    String?
  assignedById String
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  quiz       PracticeTest @relation(fields: [quizId], references: [id], onDelete: Cascade)
  class      Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy User         @relation("QuizAssigner", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([quizId, classId])
  @@unique([quizId, studentId])
  @@index([studentId])
  @@index([classId])
  @@map("quiz_assignments")
}

/// One sitting of a quiz. Attempts are numbered so a student can retake a
/// quiz and Jinni can measure improvement between sittings.
model QuizAttempt {
  id             String        @id @default(cuid())
  quizId         String
  studentId      String
  attemptNumber  Int           @default(1)
  status         AttemptStatus @default(IN_PROGRESS)
  totalQuestions Int
  score          Int?
  percentage     Int?
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  quiz     PracticeTest         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student  Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers  StudentAnswer[]
  concepts ConceptPerformance[]
  analysis AIAnalysis?

  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, status])
  @@index([quizId])
  @@map("quiz_attempts")
}

/// A single answer within an attempt. Saved as the student works so a
/// refresh mid-quiz does not lose their progress.
model StudentAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  answer     String
  isCorrect  Boolean?
  answeredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempt  QuizAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("student_answers")
}

/// Per-concept accuracy for one attempt, stored rather than recomputed so
/// progress on a concept can be charted across attempts.
model ConceptPerformance {
  id         String       @id @default(cuid())
  attemptId  String
  studentId  String
  conceptTag String
  topicId    String?
  correct    Int
  total      Int
  /// Percentage, 0-100.
  accuracy   Int
  level      ConceptLevel
  createdAt  DateTime     @default(now())

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([attemptId, conceptTag])
  @@index([studentId, conceptTag])
  @@index([studentId, createdAt])
  @@map("concept_performances")
}

/// Jinni's written feedback on one attempt. Stored so the same attempt is
/// never sent to Gemini twice.
model AIAnalysis {
  id              String   @id @default(cuid())
  attemptId       String   @unique
  studentId       String
  summary         String
  /// Concept tags, as string arrays.
  strongAreas     Json
  weakAreas       Json
  /// Why the wrong answers were likely chosen.
  misconceptions  String
  /// What to study or practise next, as a string array.
  recommendations Json
  generatedBy     String   @default("mock")
  createdAt       DateTime @default(now())

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("ai_analyses")
}

/// A thread between two people about one student. Participants are stored in
/// a stable order so a pair always resolves to the same conversation.
model Conversation {
  id             String   @id @default(cuid())
  studentId      String
  participantAId String
  participantBId String
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  participantA User      @relation("ConversationParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User      @relation("ConversationParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([studentId, participantAId, participantBId])
  @@index([participantAId, lastMessageAt])
  @@index([participantBId, lastMessageAt])
  @@map("conversations")
}
